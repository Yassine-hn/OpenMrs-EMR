map $request_uri $csp_header {
  default "default-src 'self' 'unsafe-inline' 'unsafe-eval' blob: data: localhost localhost:*; worker-src 'self' blob:; child-src 'self' blob:; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' blob:; base-uri 'self'; frame-ancestors 'self' ${FRAME_ANCESTORS};";
  "~^/openmrs/(?:admin|dictionary|module|patientDashboard.form)/" "default-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; base-uri 'self'; font-src 'self'; frame-ancestors 'self';";
  "~^/openmrs/owa" "default-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; base-uri 'self'; font-src 'self' data:; img-src 'self' data:; frame-ancestors 'self';";
}

map $http_x_forwarded_proto $forwarded_proto {
  "~.*" $http_x_forwarded_proto;
  default    $scheme;
}

map $http_x_real_ip $forwarded_ip {
  "~.*"  $http_x_real_ip;
  default $remote_addr;
}

server {
  listen [::]:80;
  listen       80;

  add_header X-XSS-Protection "1; mode=block";
  add_header Content-Security-Policy $csp_header;
  add_header X-Content-Type-Options nosniff;

  proxy_set_header      HOST $host;
  proxy_set_header      X-Forwarded-Proto $forwarded_proto;
  proxy_set_header      X-Real-IP $forwarded_ip;
  proxy_set_header      X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_http_version    1.1;

  # Rewrite OpenMRS session cookie path from /openmrs to / so the browser sends it for /ohif and /dicom-web
  proxy_cookie_path /openmrs /;
  proxy_cookie_path /openmrs/ /;

  gzip on;
  gzip_vary on;
  # 1 KiB
  gzip_min_length 1024;
  gzip_proxied any;
  gzip_http_version 1.0;
  gzip_types  font/eot
              font/otf
              font/ttf
              image/svg+xml
              text/css
              text/javascript
              text/plain
              text/xml
              application/atom+xml
              application/geo+json
              application/importmap+json
              application/javascript
              application/x-javascript
              application/json
              application/ld+json
              application/fhir+json
              application/fhir+xml
              application/manifest+json
              application/rdf+xml
              application/rss+xml
              application/xhtml+xml
              application/xml;

  # all redirects are relative to the gateway
  absolute_redirect off;

  resolver 127.0.0.11 valid=30s ipv6=off;

  # Internal subrequest for OpenMRS session authentication check
  location = /_auth_openmrs {
    internal;
    set $auth_backend http://backend:8080/openmrs/ws/rest/v1/user;
    proxy_pass $auth_backend;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header X-Original-URI $request_uri;
    proxy_set_header Cookie $http_cookie;
  }

  # OpenMRS 3 Single Page Application (frontend)
  location /openmrs/spa/ {
    set $frontend http://frontend;
    rewrite ^/openmrs/spa/(.*) /$1 break;
    proxy_pass $frontend;
  }

  # OpenMRS Backend REST / WS / Legacy Admin
  location /openmrs {
    set $backend http://backend:8080;
    proxy_read_timeout 300s;
    proxy_pass $backend;
  }

  # Grafana monitoring (optional)
  location /grafana {
    set $grafana http://grafana:3000;
    proxy_read_timeout 300s;
    proxy_pass $grafana;
  }

  # OHIF Web Viewer - protected by OpenMRS session authentication
  location /ohif/ {
    auth_request /_auth_openmrs;
    set $ohif http://ohif;
    proxy_pass $ohif;
  }

  location = /ohif {
    return 301 /ohif/;
  }

  # Orthanc DICOMweb REST API - protected by OpenMRS session authentication
  location /dicom-web/ {
    auth_request /_auth_openmrs;
    set $orthanc http://orthanc:8042;
    proxy_pass $orthanc;
    # Large body size for CD/USB DICOM uploads
    client_max_body_size 1024M;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;
  }

  location = /dicom-web {
    return 301 /dicom-web/;
  }

  location = /openmrs/spa/ {
    return 301 /openmrs/spa/home;
  }

  location = /openmrs/spa {
    return 301 /openmrs/spa/home;
  }

  location = / {
    return 301 /openmrs/spa/home;
  }
}
