# Copy to .env and replace every CHANGE_ME value:
#   cp .env.example .env
# .env is git-ignored. docker-compose.yml refuses to start if these are unset.

# Image versions are NOT set here: they are pinned by digest in docker-compose.yml, so the
# repository itself records exactly which images run. See README "Upgrading".

# Host port the gateway (single entry point) is published on.
HTTP_PORT=80

# Database credentials (MariaDB). Used by both the db and backend containers.
OMRS_DB_USER=openmrs
OMRS_DB_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# OpenMRS "admin" account password, applied when the database is created (first start).
# OpenMRS rules: at least 8 characters, with upper case, lower case and a digit.
OMRS_ADMIN_PASSWORD=CHANGE_ME

# Orthanc PACS database credentials (PostgreSQL 16)
ORTHANC_DB_USER=orthanc
ORTHANC_DB_PASSWORD=CHANGE_ME
ORTHANC_DB_NAME=orthanc

# Orthanc DICOM Application Entity Title
ORTHANC_AET=ORTHANC

